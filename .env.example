APP_ENV=development
APP_DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/gulavlival_grand
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:your_password@localhost:5432/gulavlival_grand

# Security
SECRET_KEY=generate_a_secure_jwt_secret_key_here
JWT_SECRET=generate_a_secure_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Admin Seed Credentials
ADMIN_EMAIL=admin@gulavlivalgrand.com
ADMIN_PASSWORD=admin123

# URLs & Services
BACKEND_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PROPERTY_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
